{
  "name": "@cloak/sdk",
  "version": "0.1.0",
  "description": "Sealed-bid, uniform-price token launches for Elysium: create launches, place timelock-sealed bids, run a reveal keeper.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bytecode": {
      "types": "./dist/bytecode.d.ts",
      "default": "./dist/bytecode.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "tlock-js": "0.9.0",
    "viem": "2.21.54"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
