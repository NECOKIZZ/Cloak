{
  "name": "@cloakely/sdk",
  "version": "0.3.0",
  "description": "Cloak on Elysium: sealed-bid token launches and private trading (shielded balances, private swaps, batch auctions, private sends) with on-device zero-knowledge proofs.",
  "keywords": [
    "cloak",
    "elysium",
    "kinetiq",
    "hyperliquid",
    "hype",
    "sealed-bid",
    "auction",
    "token-launch",
    "privacy",
    "zero-knowledge",
    "groth16",
    "shielded",
    "viem"
  ],
  "homepage": "https://cloak.boblabs.tech/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NECOKIZZ/Cloak.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/NECOKIZZ/cloak/issues"
  },
  "author": "Bob Labs",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bytecode": {
      "types": "./dist/bytecode.d.ts",
      "default": "./dist/bytecode.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@noble/ciphers": "1.0.0",
    "@noble/curves": "1.6.0",
    "@noble/hashes": "1.5.0",
    "circomlibjs": "0.1.7",
    "snarkjs": "0.7.5",
    "tlock-js": "0.9.0"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "viem": "2.21.54"
  },
  "peerDependencies": {
    "viem": ">=2.21.0 <3"
  }
}
