{
  "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @cloakely/sdk build && pnpm --filter @cloakely/mcp build && pnpm --filter @cloakely/web build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/claim",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|facebookexternalhit|Facebot|Discordbot|TelegramBot|Slackbot|LinkedInBot|WhatsApp|SkypeUriPreview|redditbot|Embedly|Pinterest|Applebot|Iframely|Bluesky|Mastodon).*"
        }
      ],
      "destination": "/api/preview?kind=claim"
    },
    {
      "source": "/pay",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|facebookexternalhit|Facebot|Discordbot|TelegramBot|Slackbot|LinkedInBot|WhatsApp|SkypeUriPreview|redditbot|Embedly|Pinterest|Applebot|Iframely|Bluesky|Mastodon).*"
        }
      ],
      "destination": "/api/preview?kind=pay"
    },
    {
      "source": "/app/launch/:a",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|facebookexternalhit|Facebot|Discordbot|TelegramBot|Slackbot|LinkedInBot|WhatsApp|SkypeUriPreview|redditbot|Embedly|Pinterest|Applebot|Iframely|Bluesky|Mastodon).*"
        }
      ],
      "destination": "/api/preview?a=:a"
    },
    {
      "source": "/api/nft/:drop/:id",
      "destination": "/api/nft?drop=:drop&id=:id"
    },
    {
      "source": "/tokenlist.json",
      "destination": "/api/tokenlist"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/roadmap",
      "destination": "/roadmap.html"
    },
    {
      "source": "/((?!assets/|circuits/|tokens/|brand/|hero/|media/|api/|demo-nft/|roadmap).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https: wss:; frame-src https://verify.walletconnect.com https://verify.walletconnect.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/circuits/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/demo-nft/([0-9]+)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/demo-nft/(.*).svg",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
