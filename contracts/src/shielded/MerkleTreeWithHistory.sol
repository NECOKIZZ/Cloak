pragma solidity ^0.8.24;

import {IPoseidon2} from "./interfaces/IHasher.sol";

/// @notice Append-only Poseidon Merkle tree, depth 20 (1,048,576 leaves).
/// @dev Node hash = Poseidon(left, right). Empty leaf = 0, zeros[i+1] = Poseidon(zeros[i], zeros[i]).
///      Must match `src/merkleproof.circom` and the SDK tree exactly.
///      Every root ever produced stays valid forever (`knownRoots`), so a proof built
///      against an older root still lands after other transactions (Monad: 300 ms blocks).
abstract contract MerkleTreeWithHistory {
    uint256 public constant FIELD_SIZE =
        21888242871839275222246405745257275088548364400416034343698204186575808495617;
    uint32 public constant LEVELS = 20;

    IPoseidon2 public immutable hasher;

    uint32 public nextIndex;
    uint256 public currentRoot;
    uint256[LEVELS] public filledSubtrees;
    mapping(uint256 => bool) public knownRoots;

    error TreeFull();
    error ValueOutOfField();

    constructor(IPoseidon2 hasher_) {
        hasher = hasher_;
        for (uint32 i = 0; i < LEVELS; i++) {
            filledSubtrees[i] = zeros(i);
        }
        currentRoot = zeros(LEVELS);
        knownRoots[currentRoot] = true;
    }

    function hashLeftRight(uint256 left, uint256 right) public view returns (uint256) {
        if (left >= FIELD_SIZE || right >= FIELD_SIZE) revert ValueOutOfField();
        return hasher.poseidon([left, right]);
    }

    function _insert(uint256 leaf) internal returns (uint32 index) {
        uint32 _nextIndex = nextIndex;
        if (_nextIndex == uint32(1) << LEVELS) revert TreeFull();
        uint32 currentIndex = _nextIndex;
        uint256 currentLevelHash = leaf;
        uint256 left;
        uint256 right;
        for (uint32 i = 0; i < LEVELS; i++) {
            if (currentIndex % 2 == 0) {
                left = currentLevelHash;
                right = zeros(i);
                filledSubtrees[i] = currentLevelHash;
            } else {
                left = filledSubtrees[i];
                right = currentLevelHash;
            }
            currentLevelHash = hashLeftRight(left, right);
            currentIndex /= 2;
        }
        currentRoot = currentLevelHash;
        knownRoots[currentLevelHash] = true;
        nextIndex = _nextIndex + 1;
        return _nextIndex;
    }

    function isKnownRoot(uint256 root) public view returns (bool) {
        return root != 0 && knownRoots[root];
    }

    /// @dev zeros(0) = 0; zeros(i+1) = Poseidon(zeros(i), zeros(i)). zeros(20) is the empty root.
    ///      Generated by scripts/gen-zeros.mjs and checked by test_zeros_match_poseidon.
    function zeros(uint256 i) public pure returns (uint256) {
        if (i == 0) return 0;
        if (i == 1) return 14744269619966411208579211824598458697587494354926760081771325075741142829156;
        if (i == 2) return 7423237065226347324353380772367382631490014989348495481811164164159255474657;
        if (i == 3) return 11286972368698509976183087595462810875513684078608517520839298933882497716792;
        if (i == 4) return 3607627140608796879659380071776844901612302623152076817094415224584923813162;
        if (i == 5) return 19712377064642672829441595136074946683621277828620209496774504837737984048981;
        if (i == 6) return 20775607673010627194014556968476266066927294572720319469184847051418138353016;
        if (i == 7) return 3396914609616007258851405644437304192397291162432396347162513310381425243293;
        if (i == 8) return 21551820661461729022865262380882070649935529853313286572328683688269863701601;
        if (i == 9) return 6573136701248752079028194407151022595060682063033565181951145966236778420039;
        if (i == 10) return 12413880268183407374852357075976609371175688755676981206018884971008854919922;
        if (i == 11) return 14271763308400718165336499097156975241954733520325982997864342600795471836726;
        if (i == 12) return 20066985985293572387227381049700832219069292839614107140851619262827735677018;
        if (i == 13) return 9394776414966240069580838672673694685292165040808226440647796406499139370960;
        if (i == 14) return 11331146992410411304059858900317123658895005918277453009197229807340014528524;
        if (i == 15) return 15819538789928229930262697811477882737253464456578333862691129291651619515538;
        if (i == 16) return 19217088683336594659449020493828377907203207941212636669271704950158751593251;
        if (i == 17) return 21035245323335827719745544373081896983162834604456827698288649288827293579666;
        if (i == 18) return 6939770416153240137322503476966641397417391950902474480970945462551409848591;
        if (i == 19) return 10941962436777715901943463195175331263348098796018438960955633645115732864202;
