{
  "name": "cloak",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @cloak/sdk build",
    "abis": "cd contracts && forge build && cd .. && node scripts/gen-abis.mjs",
    "test": "cd contracts && forge test && cd .. && pnpm --filter @cloak/sdk test",
    "e2e": "node e2e/run.mjs",
    "deploy:factory": "node e2e/deploy.mjs",
    "seed": "node e2e/seed.mjs",
    "keeper": "node services/keeper/index.mjs",
    "web": "pnpm --filter @cloak/web dev"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "underscore@<1.13.8": "^1.13.8"
    }
  }
}
